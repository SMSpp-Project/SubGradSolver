################################ makefile-c ##################################
##############################################################################
#                                                                            #
#   complete makefile of SubGradSolver                                       #
#                                                                            #
#   The makefile defines internally all external libraries (comprised the    #
#   SMS++ one) required by SubGradSolver. Accordingly, all necessary OBJ, H, #
#   -I directives, external libraries + -L<libdirs> are added to the         #
#   corresponding SBGSLV* macros.                                            #
#                                                                            #
#   Input:  $(CC)       = compiler command                                   #
#           $(SW)       = compiler options                                   #
#           $(SBGSLVSDR) = the directory where SubGradSolver source is       #
#           $(SBGSLVODR) = the directory where the objects have to be put    #
#                                                                            #
#   Output: $(SBGSLVOBJ) = the final object(s) / library                     #
#           $(SBGSLVLIB) = external libraries + -L<libdirs>                  #
#           $(SBGSLVH)   = the .h files to include for SubGradSolver         #
#           $(SBGSLVINC) = the -I$( SubGradSolver directory )                #
#                                                                            #
#                                VERSION 1.12                                #
#                               30 - 12 - 2020                               #
#                                                                            #
#                              Antonio Frangioni                             #
#                               Enrico Gorgone                               #
#                               Laura Fiorella                               #
#                          Operations Research Group                         #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I<include directories>

# define input macros for libCPLEX library makefile, then include it

#SBGSLVSDR=/home/pollo0397/Desktop/smspp-project/SubGradSolver

# include the makefile requiring all external modules in input
include $(SBGSLVSDR)makefile

# macroes to be exported- - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external stuff defined in the other makefiles to SBGSLVOBJ,
# SBGSLVINC and SBGSLVH, thus the := assignment has to be used (use GNU make)
SBGSLVOBJ := $(SBGSLVOBJ) 
SBGSLVINC := $(SBGSLVH) $(SBGSLVSDR)Stepsize.h \
$(SBGSLVSDR)Deflection.h $(SBGSLVSDR)Deflection/PrimalDual.h \
$(SBGSLVSDR)Deflection/Volume.h $(SBGSLVSDR)Stepsize/ColorTV.h \
$(SBGSLVSDR)Stepsize/FumeroTV.h $(SBGSLVSDR)Stepsize/Polyak.h
SBGSLVH:= $(SBGSLVINC) 
 

# external libreries for SubGradSolver
#SBGSLVLIB = 

############################ End of makefile #################################
